<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Professional Homepage</title>
    <style>
        /* Base Reset Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            line-height: 1.6;
            color: #333;
            background-color: #f9f9f9;
        }

        /* Header & Navigation Bar Styling */
        header {
            background-color: #1a1a1a;
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            color: #fff;
            font-size: 1.5rem;
            font-weight: bold;
            text-decoration: none;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 1.5rem;
        }

        .nav-links a {
            color: #ddd;
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: #ff6b6b;
        }

        /* Hero Section Styling */
        .hero {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://picsum.photos') no-repeat center center/cover;
            height: 60vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #fff;
            padding: 0 1rem;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
            max-width: 600px;
        }

        .cta-btn {
            background-color: #ff6b6b;
            color: #fff;
            padding: 0.75rem 1.5rem;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            transition: background 0.3s ease;
        }

        .cta-btn:hover {
            background-color: #e55353;
        }

        /* Main Content Container */
        main {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        /* Features Section Grid */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .card {
            background: #fff;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            text-align: center;
        }

        .card h3 {
            margin-bottom: 1rem;
            color: #1a1a1a;
        }

        /* Footer Styling */
        footer {
            background-color: #1a1a1a;
            color: #fff;
            text-align: center;
            padding: 1.5rem;
            margin-top: 4rem;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Header containing Logo and Menu Layout -->
    <header>
        <nav>
            <a href="#" class="logo">BrandName</a>
            <ul class="nav-links">
                <li><a href="#">Home</a></li>
                <li><a href="#">About</a></li>
                <li><a href="#">Services</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Visual Hero Spotlight Area -->
    <section class="hero">
        <h1>Welcome to Our Website</h1>
        <p>We create clean, modern, and fully responsive digital experiences tailored perfectly to your target audience.</p>
        <a href="#" class="cta-btn">Get Started Today</a>
    </section>

    <!-- Main Content Presentation Layout -->
    <main>
        <section style="text-align: center; margin-bottom: 2rem;">
            <h2>Our Core Services</h2>
            <p style="color: #666;">Discover how we can help elevate your digital presence.</p>
        </section>

        <section class="features">
            <div class="card">
                <h3>Web Design</h3>
                <p>Crafting gorgeous, intuitive, and modern web layouts focused entirely on user conversion metrics.</p>
            </div>
            <div class="card">
                <h3>Development</h3>
                <p>Building clean, scalable, lightweight codebases using modern standard architectures.</p>
            </div>
            <div class="card">
                <h3>Marketing</h3>
                <p>Optimizing organic engine discovery visibility and structured performance advertising channels.</p>
            </div>
        </section>
    </main>

    <!-- Footer Copyright and Info Line -->
    <footer>
        <p>&copy; 2026 BrandName. All rights reserved.</p>
    </footer>

</body>
</html>
